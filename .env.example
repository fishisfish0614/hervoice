# hervoice 配置 — 复制为 .env 填写，别把 .env 提交进 git

# 转写：Groq Whisper（免费额度足够个人用）https://console.groq.com
GROQ_API_KEY=

# 情感分析 LLM：任何 OpenAI 兼容接口都行（默认 DeepSeek，便宜）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# ── 转写 ──
WHISPER_MODEL=whisper-large-v3
# 留空=自动识别语种(推荐)。锁成 zh 时外语会被直接翻译成中文
WHISPER_LANG=
# 识别出的语种不在这里时，用 WHISPER_FALLBACK_LANG 重转(防短句被认成别的语言)。Whisper 的语种名，小写英文
WHISPER_LANGS=chinese,english
WHISPER_FALLBACK_LANG=zh
# 名字、昵称、常用词。第一人称短句，额外的词放句尾；措辞敏感，见 README「转写提示词」
WHISPER_PROMPT=
# Whisper 对着静音编出来的句子，用 | 分隔
# WHISPER_HALLUCINATIONS=请不吝点赞|明镜与点点|Thank you for watching|字幕由

# ── 判情感 ──
# 你的情绪标签，逗号分隔(标注页同款)
# HERVOICE_TAGS=撒娇,嗔怪·假生气,打闹·玩闹,真生气,委屈,难过,累,焦虑,开心,兴奋,想念,表达爱意,害羞,平静,认真说事
# 给 LLM 的称呼：谁在说话、在对谁说
HERVOICE_SPEAKER=
HERVOICE_LISTENER=
# 从你的标注里挑几个例子给 LLM
# FEWSHOT_N=15
# 个人声学分类器的哪些标签信号给 LLM 看(声学上靠谱的那几个)、阈值
# ACOUSTIC_SHOW_TAGS=难过,委屈,开心,认真说事,真生气
# ACOUSTIC_THRESHOLD=0.6

# ── 静音门(任一命中=没人声，不调 Whisper)──
# GATE_MIN_DURATION=0.5
# GATE_MAX_PAUSE=0.75
# GATE_MIN_PITCH=100

# 分析出结果后 POST 到这个 URL — 接你自己的 AI 助手/心跳/通知。留空则不回调。
# 收到的 JSON: {ts,text,emotion,tags,confidence,hint,tone,features,acoustic,audio}
HERVOICE_WEBHOOK=

# 数据目录(日志、标注、可选的音频、训练出的模型都在这)
HERVOICE_DATA=./data

# 是否留存音频。默认 0 = 阅后即焚（只留文字和情感）。
# 设 1 = 保留 mp3，可重听，标注页需要它。留存是隐私决定，自己权衡。
KEEP_AUDIO=0
